# Example .env for pushmo0n-bot

# Required: Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

#   XRAY_SUBSCRIPTION_URL — ссылка на подписку (приоритетнее)
#   XRAY_VLESS_URL        — прямой VLESS URL
XRAY_SUBSCRIPTION_URL=https://your.subscription.url/path

#XRAY_VLESS_URL=vless://uuid@server:443?security=reality&type=xhttp&...

# Optional: set LANGUAGE=ru to make bot messages Russian. Default is English.
#LANGUAGE=ru
